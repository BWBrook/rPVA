# History files
.Rhistory
.Rapp.history

# Session Data files
.RData
.RDataTmp

# User-specific files
.Ruserdata

# Example code in package build process
*-Ex.R

# Output files from R CMD build
/*.tar.gz
/*.zip

# Output files from R CMD check
/*.Rcheck/

# RStudio files
.Rproj.user/

# produced vignettes
vignettes/*.html
vignettes/*.pdf

# OAuth2 token, see https://github.com/hadley/httr/releases/tag/v0.3
.httr-oauth

# knitr and R markdown default cache directories
*_cache/
/cache/

# Temporary files created by R markdown
*.utf8.md
*.knit.md

# R Environment Variables
.Renviron

# pkgdown site, except Codex project-management notes
docs/*
!docs/codex/
!docs/codex/**
!docs/goals/
!docs/goals/**
!docs/ops/
!docs/ops/**
!docs/teaching/
!docs/teaching/**

# translation temp files
po/*~

# RStudio Connect folder
rsconnect/

# renv
renv/library/
renv/staging/

# Quarto / rmarkdown artefacts
*.html                  # rendered notebooks
*.knit.md
rPVA_files/        # html asset dir (JS/CSS/img)
docs/teaching/woodhen/.gitignore

# _targets
# The object store is committed ONCE; ignore future changes
# Remove the leading "!" below if you decide to ship no cache at all.
!_targets/              # keep the committed cache
_targets/**             # but ignore any new/changed files

# Misc
.DS_Store
.vscode/
.idea/
.worktrees/

